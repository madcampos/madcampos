---
const framesetHtml = `
	<frameset cols="50%, 50%" rows="50%, 50%">
		<frame src="/assets/test/tic-tac-toe.html"></frame>
		<frame src="/assets/test/tic-tac-toe.html"></frame>
		<frame src="/assets/test/tic-tac-toe.html"></frame>
		<frame src="/assets/test/tic-tac-toe.html"></frame>
	</frameset>
`;
---
<details open>
	<summary>
		<h2>Obsolete Elements</h2>
	</summary>

	<section>
		<h3>Acronym Element</h3>
		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>&lt;abbr&gt;</code> element instead.</span>
		</m-note>

		<p><acronym title="Thank God It is Friday">TGIF</acronym></p>
	</section>

	<section>
		<h3>Applet Element</h3>
		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>&lt;embed&gt;</code> or <code>&lt;object&gt;</code> elements instead.</span>
		</m-note>

		<applet code="/assets/test/MyApplet.class" width="400" height="300">
			Wow, look at your modern browser. It does not support Java applets.
		</applet>
	</section>

	<section>
		<h3>Base Font Element</h3>
		<m-note data-type="warning">
			<span><strong>Note:</strong> Use CSS instead.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> This element should not render anything on modern browsers, nor change the document's font.</span>
		</m-note>

		<!-- dprint-ignore -->
		<basefont color="hotpink" face="cursive" size="7"/>
	</section>

	<section>
		<h3>Big Text Element</h3>
		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the CSS <code>font-size</code> property instead.</span>
		</m-note>

		<p><big>Large Boi</big></p>
	</section>

	<section>
		<h3>Blink Element</h3>
		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the CSS animations instead.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> The <code>&lt;blink&gt;</code> element is bad for accessibility as it does not provide a way to control it's animation.</span>
		</m-note>

		<p><blink>Strobe effect!</blink></p>
	</section>

	<section>
		<h3>Background Sound Element</h3>
		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>&lt;audio&gt;</code> element instead.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> This element should not render anything on modern browsers, nor play any sound.</span>
		</m-note>

		<bgsound src="/assets/test/sample-tune.mp3" loop="infinite" />
	</section>

	<section>
		<h3>Text Centering Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use CSS for this instead.</span>
		</m-note>

		<center><p>This will be centered, apparently.</p></center>
	</section>

	<section>
		<h3>Directory Listing Element</h3>

		<m-note data-type="warning">
			<span>
				<span><strong>Note:</strong> Use the <code>&lt;ul&gt;</code> or <code>&lt;ol&gt;</code> elements for simple lists.</span>
				<br />
				<span>Or use the <a href="https://www.w3.org/WAI/ARIA/apg/patterns/treeview/">Tree View</a> pattern instead.</span>
			</span>
		</m-note>

		<dir>
			<li>..</li>
			<li>.</li>
			<li>.git</li>
			<li>lib</li>
			<li>src</li>
			<li>DO_NOT_READ.txt</li>
			<li>not-a-virus.exe</li>
			<li>README.md</li>
			<li>untitled.txt</li>
		</dir>
	</section>

	<section>
		<h3>Font Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use CSS instead.</span>
		</m-note>

		<p><font color="deeppink" face="'Comic Sans MS', cursive">I'm pretty</font></p>
	</section>

	<section>
		<h3>Frameset & Frame Elements</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>&lt;iframe&gt;</code> element instead.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> These elements should not render on modern browsers and may actually be removed from the DOM tree altogether.</span>
		</m-note>

		<Fragment set:html={framesetHtml} />
	</section>

	<section>
		<h3>Image Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>&lt;img&gt;</code> element instead.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> On modern browsers, this element may get converted to an <code>&lt;img&gt;</code> element.</span>
		</m-note>

		{/* @ts-expect-error - Astro considers an error using the src attribute. */}
		<image
			src="/assets/test/good-parts.webp"
			alt="A photo of two books, side by side, with the first being much bigger than the second. The books are, respectively: Javascript the Definitive Guide; and Javascript the Good Parts"
			width="512"
		/>
	</section>

	<section>
		<h3>Is Index Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use a <code>&lt;form&gt;</code> and <code>&lt;input&gt;</code> elements combination instead.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> This element should not render anything on modern browsers, on supported browsers it would render a search box.</span>
		</m-note>

		<!-- dprint-ignore -->
		<isindex prompt="Enter Ye Olde Searche" />
	</section>

	<section>
		<h3>Keygen Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>Web Crypto API</code> instead.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> This element should not render anything on modern browsers.</span>
		</m-note>

		<p>
			<label for="keygen">Keygen:</label>
			<!-- dprint-ignore -->
			<keygen id="keygen" name="key" challenge="supersecretchallange" />
		</p>
	</section>

	<section>
		<h3>Listing Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>&lt;pre&gt;</code> or <code>&lt;code&gt;</code> elements instead.</span>
		</m-note>

		<!-- dprint-ignore -->
		<listing>
10 PRINT "HELLO WORLD"
20 GOTO 10
		</listing>
	</section>

	<section>
		<h3>Marquee Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use CSS instead.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> The <code>&lt;marquee&gt;</code> element is bad for accessibility as it does not provide a way to control it's animation.</span>
		</m-note>

		<marquee direction="up" behavior="alternate" width="640" height="480">
			<marquee behavior="alternate">
				<img height="80" width="80" src="https://www.freeiconspng.com/uploads/dvd-logo-png-33.png" alt="DVD Logo" style="margin: 0" />
			</marquee>
		</marquee>
	</section>

	<section>
		<h3>Menu Item Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Implement a listener for the <code>contextmenu</code> event.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> This element should render as regular spans of text on modern browsers.</span>
		</m-note>

		<p contextmenu="popup-menu">
			Right-click me.
		</p>

		<!-- dprint-ignore -->
		<menu type="context" id="popup-menu">
			{/* @ts-expect-error - Astro considers an error using the type attribute. */}
			<menuitem type="checkbox" label="Checkbox" checked="true" />
			{/* @ts-expect-error - Astro considers an error using the type attribute. */}
			<menuitem type="command" label="Command" icon="/assets/test/icon.svg" />
			{/* @ts-expect-error - Astro considers an error using the type attribute. */}
			<menuitem type="radio" lable="Radio Button 1" name="group1" checked="true" />
			{/* @ts-expect-error - Astro considers an error using the type attribute. */}
			<menuitem type="radio" lable="Radio Button 2" name="group1" />
		</menu>
	</section>

	<section>
		<h3>Multicolumn Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>columns</code> CSS property instead.</span>
		</m-note>

		<multicol cols="2" gutter="30">
			<p>
				Lorem ipsum dolor sit amet consectetur adipisicing elit. Ea sapiente, magni alias itaque beatae perferendis qui magnam minima obcaecati omnis dignissimos sequi
				laudantium mollitia ipsa autem dolores ut, a ullam.
			</p>

			<p>
				Lorem, ipsum dolor sit amet consectetur adipisicing elit. Aut numquam maxime labore vero beatae dolore iste, animi, architecto dolorem ducimus explicabo aliquid
				laudantium inventore eligendi velit soluta cumque, facilis optio.
			</p>
		</multicol>
	</section>

	<section>
		<h3>NeXT ID Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use other ways to provide ID's such as the <code>crypto.randomUUID()</code> method instead.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> This element should not render on modern browsers.</span>
		</m-note>

		<p>
			<nextid n="a0" />
		</p>
	</section>

	<section>
		<h3>Non-Breaking Text Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>white-space</code> CSS property instead.</span>
		</m-note>

		<p style="max-inline-size: var(--size-content-0); outline: solid thin var(--theme-color); overflow: auto" tabindex="0">
			<nobr>pneumonoultramicroscopicsilicovolcanoconiosis</nobr>
		</p>
	</section>

	<section>
		<h3>No Embed Element</h3>

		<m-note data-type="warning">
			<span>
				<span><strong>Note:</strong> The <code>&lt;embed&gt;</code> element does not provide a fallback option automatically.</span>
				<br />
				<span>Use the <code>&lt;object&gt;</code> or <code>&lt;iframe&gt;</code> elements instead if this functionality is needed.</span>
			</span>
		</m-note>

		<p>Show fallback content if the <code>&lt;embed&gt;</code> element is not supported:</p>
		<noembed>No embed for you.</noembed>
	</section>

	<section>
		<h3>No Frames Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>&lt;object&gt;</code> or <code>&lt;iframe&gt;</code> elements instead if this functionality is needed.</span>
		</m-note>

		<p>Show fallback content if the <code>&lt;frame&gt;</code> element is not supported:</p>
		<noframes>No frame for you.</noframes>
	</section>

	<section>
		<h3>Object Parameter Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Plugins are unsupported in modern browsers. If you need to pass data to an element use the <code>data-*</code> attributes instead.</span>
		</m-note>

		<p>Flash file (<a href="hhttps://ruffle.rs/" target="_blank" rel="noopener noreferrer">Ruffle</a>'s logo):</p>
		<object
			data="/assets/test/ruffle-logo.swf"
			type="application/x-shockwave-flash"
			width="320"
			height="240"
		>
			<param name="pluginurl" value="http://www.adobe.com/go/getflashplayer" />
			<param name="quality" value="high" />
			<param name="bgcolor" value="#fff" />
			<p>The flash file did not load.</p>
		</object>

		<m-note data-type="info">
			<span>This file will not load as flash is not supported anymore, regardless.</span>
		</m-note>
	</section>

	<section>
		<h3>Plain Text Element</h3>

		<m-note data-type="alert">
			<span><strong>Note: <em>DON'T USE THIS ELEMENT.</em></strong></span>
		</m-note>

		<m-note data-type="warning">
			<span><strong>I repeat: <em>DON'T USE THIS ELEMENT.</em></strong></span>
		</m-note>

		<m-note data-type="error">
			<span><strong>For good measure: <em>DON'T USE THIS ELEMENT.</em></strong></span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> Use the <code>&lt;pre&gt;</code> element instead.</span>
		</m-note>

		<p>This element will make <strong><em>EVERYTHING</em></strong> after it to render as plain text.</p>

		<iframe
			src="/assets/test/plaintext.html"
			loading="lazy"
			title="An example of the plaintext element"
		></iframe>
	</section>

	<section>
		<h3>Ruby Base & Ruby Text Container Elements</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use just the text inside a <code>&lt;ruby&gt;</code> element instead.</span>
		</m-note>

		<p>
			<ruby lang="ja">
				<rb>振</rb><rp>(</rp><rt>ふ</rt><rp>)</rp>
				<rb>り</rb><rt>&nbsp;</rt>
				<rb>仮</rb><rp>(</rp><rt>が</rt><rp>)</rp>
				<rb>名</rb><rp>(</rp><rt>な</rt><rp>)</rp>
				<rtc lang="en">
					<rp>(</rp>
					<rt>Furigana</rt>
					<rp>)</rp>
				</rtc>
			</ruby>
		</p>
	</section>

	<section>
		<h3>Spacer Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use CSS instead.</span>
		</m-note>

		<p>This text has a <spacer type="horizontal" size="100"></spacer> gap.</p>
	</section>

	<section>
		<h3>Strikethrough Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>&lt;s&gt;</code> element instead.</span>
		</m-note>

		<p>This text is <strike>stirken</strike>.</p>
	</section>

	<section>
		<h3>Teletype Text Element</h3>

		<m-note data-type="warning">
			<span>
				<strong>Note:</strong> Use one of the <code>&lt;code&gt;</code>, <code>&lt;kbd&gt;</code>, <code>&lt;samp&gt;</code>, <code>&lt;pre&gt;</code>, or <code
				>&lt;var&gt;</code> elements instead.
			</span>
		</m-note>

		<p><tt>shutdown -t 0 -r</tt></p>
	</section>

	<section>
		<h3>Example Element</h3>

		<m-note data-type="warning">
			<span><strong>Note:</strong> Use the <code>&lt;pre&gt;</code> element instead.</span>
		</m-note>

		<m-note data-type="info">
			<span><strong>Note:</strong> This element ignores HTML tags inside of it, making it error prone.</span>
		</m-note>
		<iframe
			src="/assets/test/xmp.html"
			loading="lazy"
			title="An example of the plaintext element"
		></iframe>
	</section>
</details>
