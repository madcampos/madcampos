---
import { markdown } from '@astropub/md';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type * as BaselineData from 'web-features';
import baselineData from 'web-features/data.json' with { type: 'json' };
import { inlineMarkdownStrip } from '../../utils/markdown';
import { listAllPosts, listPostsByTag } from '../../utils/post.ts';
import { listAllProjects } from '../../utils/projects.ts';
import Card from '../Card/Card.astro';
import OldStyleButtons from '../OldStyleButtons/OldStyleButtons.astro';
import Pagination from '../Pagination/Pagination.astro';
import PromptInjection from '../PromptInjection/PromptInjection.astro';
import SiteNav from '../SiteNav/SiteNav.astro';
import ThemedImage from '../ThemedImage/ThemedImage.astro';
import Webrings from '../Webrings/Webrings.astro';

import avatar from '../../../public/assets/images/me.jpg';
import hackerAvatar from '../../assets/css/themes/hacker/avatar.png';
import halloweenAvatar from '../../assets/css/themes/halloween/avatar.png';
import uwuAvatar from '../../assets/css/themes/uwu/avatar.png';
import y2kAvatar from '../../assets/css/themes/y2k/avatar.png';
import DecoratedLine from '../DecoratedLine/DecoratedLine.astro';

// oxlint-disable-next-line typescript/no-non-null-assertion
const project = (await listAllProjects())[0]!;
const ProjectContent = (await project.render()).Content;
const formatter = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });

// oxlint-disable-next-line typescript/no-non-null-assertion
const post = (await listAllPosts())[0]!;
const sorter = new Intl.Collator('en-CA', { usage: 'sort' });
const tags = Object.entries(await listPostsByTag()).map(([tag, posts]) => ({
	name: tag,
	items: posts.length
})).sort((first, second) => sorter.compare(first.name, second.name));

// oxlint-disable-next-line typescript/consistent-type-assertions
const baselineFeatures = Object.entries((baselineData as unknown as typeof BaselineData).features);
const highBaselineFeature = baselineFeatures.find(([, feature]) => feature.kind === 'feature' && feature.status.baseline === 'high')?.[0];
const lowBaselineFeature = baselineFeatures.find(([, feature]) => feature.kind === 'feature' && feature.status.baseline === 'low')?.[0];
const limitedBaselineFeature = baselineFeatures.find(([, feature]) => feature.kind === 'feature' && feature.status.baseline === false)?.[0];
const deprecatedBaselineFeature = baselineFeatures.find(([, feature]) => feature.kind === 'feature' && feature.discouraged && !feature.discouraged.removal_date)?.[0];
const toBeRemovedBaselineFeature = baselineFeatures.find(([, feature]) => feature.kind === 'feature' && feature.discouraged?.removal_date)?.[0];
---
<details open>
	<summary>
		<h2 id="components">Components</h2>
	</summary>

	<section>
		<h3 id="author-card">Author Card (<code>&lt;author-card&gt;</code>)</h3>

		<author-card>
			<div itemprop="author" itemscope itemtype="https://schema.org/Person">
				<a href="https://madcampos.dev/">
					<m-avatar>
						<ThemedImage
							image={avatar}
							imageAlt="A picture of my face with a smile looking at the camera. I&apos;m wearing aviator glasses, a fake fur winter hat and an orange scarf."
							isEager
							extraClasses={['u-photo', 'photo']}
							format="jpg"
							themeImages={{
								uwu: uwuAvatar,
								y2k: y2kAvatar,
								hacker: hackerAvatar,
								halloween: halloweenAvatar
							}}
						/>
					</m-avatar>
				</a>

				<a class="p-author h-card author-name" rel="author" itemprop="url" href="https://madcampos.dev/">
					<h2 itemprop="name" data-ignore-toc>Marco Campos</h2>
				</a>

				<p>
					Marco is a Staff developer with over 15 years of experience, ranging from front-end to back-end development, and as he likes to put it: "When I started layouts
					were done with tables and Flash was still a thing." He has a passion for accessibility and PWAs and loves to teach and share his knowledge with others. He
					strongly believe that technology and specially the web should be open and available to everyone, and that's why he's always looking for ways to make the web a
					better place and contribute to open source projects.
				</p>
			</div>
		</author-card>
	</section>

	<section>
		<h3 id="avatar">Avatar (<code>&lt;m-avatar&gt;</code>)</h3>

		<m-avatar>
			<ThemedImage
				image={avatar}
				imageAlt="A picture of my face with a smile looking at the camera. I&apos;m wearing aviator glasses, a fake fur winter hat and an orange scarf."
				isEager
				extraClasses={['u-photo', 'photo']}
				themeImages={{
					uwu: uwuAvatar,
					y2k: y2kAvatar,
					hacker: hackerAvatar,
					halloween: halloweenAvatar
				}}
			/>
		</m-avatar>
	</section>

	<section>
		<h3 id="baseline-info">Baseline Info (<code>&lt;baseline-info&gt;</code>)</h3>

		<baseline-info feature={highBaselineFeature ?? 'conic-gradients'}></baseline-info>
		<baseline-info feature={lowBaselineFeature ?? 'declarative-shadow-dom'}></baseline-info>
		<baseline-info feature={limitedBaselineFeature ?? 'network-information'}></baseline-info>
		<baseline-info feature={deprecatedBaselineFeature ?? 'svg-discouraged'}></baseline-info>
		<baseline-info feature={toBeRemovedBaselineFeature ?? 'portal'}></baseline-info>
		<baseline-info feature="foo-bar-baz"></baseline-info>
	</section>

	<section>
		<h3 id="card">Card (<code>&lt;m-card&gt;</code>)</h3>

		<p id="project-card">Project card:</p>

		<Card
			url={project.data.url}
			draft={project.data.draft}
			itemtype="http://schema.org/WebApplication"
			image={project.data.image}
			imageAlt={project.data.imageAlt ?? ''}
			themeImages={project.data.themeImages}
			extraClass="project-card"
		>
			<Fragment slot="meta">
				<meta itemprop="operatingSystem" content="https://schema.org/AllOperatingSystem" />
				<meta itemprop="browserRequirements" content="https://schema.org/GenericWebPlatform" />
				<meta itemprop="applicationCategory" content="BrowserApplication" />
				<template itemprop="offers" itemscope itemtype="https://schema.org/Offer">
					<meta itemprop="availability" content="https://schema.org/InStock" />
					<meta itemprop="price" content="0" />
					<meta itemprop="priceCurrency" content="USD" />
				</template>
				<meta itemprop="isAccessibleForFree" content="True" />
			</Fragment>
			<h2 slot="title" itemprop="name" data-ignore-toc>
				<Fragment set:html={markdown.inline(project.data.title)} />
			</h2>

			<Fragment slot="subtitle">
				<draft-tag data-status={project.data.status}>
					<Icon name={project.data.status === 'ongoing' ? 'mingcute:time-line' : 'mingcute:check-circle-line'} title="Project status" />
					{project.data.status === 'ongoing' ? 'Ongoing' : 'Finished'}
				</draft-tag>
				<span>
					<Icon name="mingcute:calendar-2-line" title="Date started" />
					<time
						data-relative-time
						datetime={project.data.createdAt.toISOString()}
						itemprop="dateCreated"
					>{formatter.format(project.data.createdAt)}</time>
					{project.data.updatedAt && (
						<span>&mdash; <time
								data-relative-time
								datetime={project.data.updatedAt.toISOString()}
								itemprop="dateModified"
							>{formatter.format(project.data.updatedAt)}</time></span>
					)}
				</span>
				<span itemprop="softwareVersion">
					<Icon name="mingcute:package-2-line" title="Current version" /> {project.data.version}
				</span>
			</Fragment>

			<ProjectContent />

			<Fragment slot="links">
				{project.data.url && (
					<a href={project.data.url} rel="noopener noreferrer" referrerpolicy="no-referrer" itemprop="installUrl">
						<Icon name="mingcute:link-2-line" aria-hidden="true" />
						View Project
					</a>
				)}
				&nbsp;
				{project.data.repository && (
					<a href={project.data.repository} rel="noopener noreferrer" referrerpolicy="no-referrer">
						<Icon name="mingcute:github-line" aria-hidden="true" />
						View Repository
					</a>
				)}
			</Fragment>

			<details slot="footer">
				<summary>
					<span>
						<Icon name="mingcute:tool-line" aria-hidden="true" />
						Technologies used
					</span>
				</summary>

				<tag-list>
					<ul>
						{project.data.techStack?.map((tech) => <li><tag-item><span>{tech}</span></tag-item></li>)}
					</ul>
				</tag-list>
			</details>
		</Card>

		<p id="post-card">Post card:</p>

		<Card
			url={`/blog/${post.url}`}
			itemtype="https://schema.org/BlogPosting"
			draft={post.data.draft}
			image={post.data.image}
			imageAlt={post.data.imageAlt ?? ''}
		>
			<h2 slot="title" itemprop="name" data-ignore-toc>
				<Fragment set:html={markdown.inline(post.data.title)} />
			</h2>
			<small slot="subtitle">
				<time
					data-relative-time
					data-pagefind-sort="date[datetime]"
					datetime={post.data.createdAt.toISOString()}
				>{formatter.format(post.data.createdAt)}</time>
			</small>

			<Fragment set:html={markdown.inline(post.data.summary)} />

			<a slot="links" href={`/blog/${post.url}`}>
				<span>Read more</span>
				<sr-only>about "{inlineMarkdownStrip(post.data.title)}"</sr-only>
				<span>...</span>
			</a>
			{post.data.tags && post.data.tags.length > 0 && (
				<details slot="footer">
					<summary>Tags</summary>
					<tag-list>
						<ul>
							{post.data.tags.map((tag) => (
								<li class="p-category">
									<tag-item>
										<a href={`/blog/tags/${tag}/`}>{tag}</a>
									</tag-item>
								</li>
							))}
						</ul>
					</tag-list>
				</details>
			)}
		</Card>
	</section>

	<section>
		<h3 id="code-wrapper">Code wrapper (<code>&lt;code-wrapper&gt;</code>)</h3>

		<p>
			Code example (pre-rendered through <a href="https://shiki.style/" target="_blank" referrerpolicy="no-referrer" rel="noopener noreferrer">Shiki</a>).
			<strong>Note:</strong> the code only highlights when inside a <code>&lt;code-wrapper&gt;</code> element:
		</p>

		<code-wrapper>
			<pre
				class="astro-code astro-code-themes light-plus dark-plus Noctis High Contrast has-diff has-highlighted has-focused"
				style="--shiki-light: #000000; --shiki-dark: #d4d4d4; --shiki-contrast: #ffffff; --shiki-light-bg: #ffffff; --shiki-dark-bg: #1e1e1e; --shiki-contrast-bg: #000000; overflow-x: auto; white-space: pre-wrap; word-wrap: break-word"
				tabindex="0"
				data-language="ts"
			><code><span class="line"><span style="--shiki-light:#008000;--shiki-light-font-style:inherit;--shiki-dark:#6A9955;--shiki-dark-font-style:inherit;--shiki-contrast:#888;--shiki-contrast-font-style:italic">//</span><span class="space"> </span><span style="--shiki-light:#008000;--shiki-light-font-style:inherit;--shiki-dark:#6A9955;--shiki-dark-font-style:inherit;--shiki-contrast:#888;--shiki-contrast-font-style:italic" class="highlighted-word">Code</span><span style="--shiki-light:#008000;--shiki-light-font-style:inherit;--shiki-dark:#6A9955;--shiki-dark-font-style:inherit;--shiki-contrast:#888;--shiki-contrast-font-style:italic"> block</span></span>
	<span class="line diff remove"><span style="--shiki-light:#001080;--shiki-dark:#9CDCFE;--shiki-contrast:#FFB966">console</span><span style="--shiki-light:#000000;--shiki-light-font-weight:inherit;--shiki-dark:#D4D4D4;--shiki-dark-font-weight:inherit;--shiki-contrast:#FF669C;--shiki-contrast-font-weight:bold">.</span><span style="--shiki-light:#795E26;--shiki-dark:#DCDCAA;--shiki-contrast:#00B4CC">log</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">(</span><span style="--shiki-light:#A31515;--shiki-dark:#CE9178;--shiki-contrast:#66FFBF">'Hewwo, World!'</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">);</span></span>
	<span class="line diff add"><span style="--shiki-light:#001080;--shiki-dark:#9CDCFE;--shiki-contrast:#FFB966">console</span><span style="--shiki-light:#000000;--shiki-light-font-weight:inherit;--shiki-dark:#D4D4D4;--shiki-dark-font-weight:inherit;--shiki-contrast:#FF669C;--shiki-contrast-font-weight:bold">.</span><span style="--shiki-light:#795E26;--shiki-dark:#DCDCAA;--shiki-contrast:#00B4CC">log</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">(</span><span style="--shiki-light:#A31515;--shiki-dark:#CE9178;--shiki-contrast:#66FFBF">'Hello, World!'</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">);</span></span>
	<span class="line highlighted"><span style="--shiki-light:#001080;--shiki-dark:#9CDCFE;--shiki-contrast:#FFB966">console</span><span style="--shiki-light:#000000;--shiki-light-font-weight:inherit;--shiki-dark:#D4D4D4;--shiki-dark-font-weight:inherit;--shiki-contrast:#FF669C;--shiki-contrast-font-weight:bold">.</span><span style="--shiki-light:#795E26;--shiki-dark:#DCDCAA;--shiki-contrast:#00B4CC">log</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">(</span><span style="--shiki-light:#A31515;--shiki-dark:#CE9178;--shiki-contrast:#66FFBF">'Highlighted'</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">);</span></span>
	<span class="line highlighted error"><span style="--shiki-light:#001080;--shiki-dark:#9CDCFE;--shiki-contrast:#FFB966">console</span><span style="--shiki-light:#000000;--shiki-light-font-weight:inherit;--shiki-dark:#D4D4D4;--shiki-dark-font-weight:inherit;--shiki-contrast:#FF669C;--shiki-contrast-font-weight:bold">.</span><span style="--shiki-light:#795E26;--shiki-dark:#DCDCAA;--shiki-contrast:#00B4CC">error</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">(</span><span style="--shiki-light:#A31515;--shiki-dark:#CE9178;--shiki-contrast:#66FFBF">'Error'</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">);</span></span>
	<span class="line highlighted warning"><span style="--shiki-light:#001080;--shiki-dark:#9CDCFE;--shiki-contrast:#FFB966">console</span><span style="--shiki-light:#000000;--shiki-light-font-weight:inherit;--shiki-dark:#D4D4D4;--shiki-dark-font-weight:inherit;--shiki-contrast:#FF669C;--shiki-contrast-font-weight:bold">.</span><span style="--shiki-light:#795E26;--shiki-dark:#DCDCAA;--shiki-contrast:#00B4CC">warn</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">(</span><span style="--shiki-light:#A31515;--shiki-dark:#CE9178;--shiki-contrast:#66FFBF">'Warning'</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">);</span></span>
	<span class="line focused"><span style="--shiki-light:#001080;--shiki-dark:#9CDCFE;--shiki-contrast:#FFB966">console</span><span style="--shiki-light:#000000;--shiki-light-font-weight:inherit;--shiki-dark:#D4D4D4;--shiki-dark-font-weight:inherit;--shiki-contrast:#FF669C;--shiki-contrast-font-weight:bold">.</span><span style="--shiki-light:#795E26;--shiki-dark:#DCDCAA;--shiki-contrast:#00B4CC">log</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">(</span><span style="--shiki-light:#A31515;--shiki-dark:#CE9178;--shiki-contrast:#66FFBF">'Focused'</span><span style="--shiki-light:#000000;--shiki-dark:#D4D4D4;--shiki-contrast:#DDD3CC">);</span></span></code></pre>
		</code-wrapper>
	</section>

	<section>
		<h3 id="css-naked-day">CSS Naked Day Info (<code>&lt;css-naked-day&gt;</code>)</h3>

		<m-note data-type="info">
			<span><strong>Note</strong>: This component is in the header of most pages, but only shows when CSS is <em>disabled</em>.</span>
		</m-note>

		<p><a href="/styleguide/?css=disabled" rel="nofollow">Reload Page with CSS off</a></p>
		<p><a href="/styleguide/?css=" rel="nofollow">Reload Page with CSS back to default</a></p>
	</section>

	<section>
		<h3 id="decorated-line">Decorated line (<code>&lt;decorated-line&gt;</code>)</h3>

		<p>
			Line with <a href="https://en.wikipedia.org/wiki/Fleuron_(typography)" target="_blank" referrerpolicy="no-referrer" rel="noopener noreferrer">fleuron</a>:
		</p>
		<DecoratedLine />
	</section>

	<section>
		<h3 id="draft-tag">Draft Tag (<code>&lt;draft-tag&gt;</code>)</h3>

		<p>Marks when a post or other entry is a "draft".</p>
		<p>This is a <draft-tag>Draft</draft-tag></p>
	</section>

	<section>
		<h3 id="hit-counter">Hit Counter (<code>&lt;hit-counter&gt;</code>)</h3>
		<hit-counter></hit-counter>
	</section>

	<section>
		<h3 id="image-lightbox">Image Lightbox (<code>&lt;img-lightbox&gt;</code>)</h3>

		<p>This enables extra features to images when they are inside a <code>&lt;img-lightbox&gt;</code> component.</p>

		<img-lightbox>
			<img
				src="/assets/test/good-parts.webp"
				alt="A photo of two books, side by side, with the first being much bigger than the second. The books are, respectively: Javascript the Definitive Guide; and Javascript the Good Parts"
				loading="lazy"
				width="512"
			/>
		</img-lightbox>
	</section>

	<section>
		<h3 id="inline-share">Inline Share (<code>&lt;inline-share&gt;</code>)</h3>

		<rendered-content>
			<p>Select this text to show the inline share options.</p>
			<blockquote>
				<p>
					Moonlit whispers drift across a stage where kings pace in troubled circles, pondering crowns that weigh heavier than iron. Ghosts linger just beyond the
					torchlight, offering riddles no mortal truly wishes to solve. Lovers trade vows beneath tangled branches, certain their passion can outwit fate, unaware that
					destiny has already sharpened its quill.
				</p>
				<p>
					In distant courts, fools speak truths disguised as jests, while courtiers bow so deeply they forget the shape of their own spines. Storms gather on the horizon,
					muttering in thunderous iambs, promising to scatter illusions like leaves in a winter gale. Somewhere, a schemer plots with a smile too polished to trust,
					convinced that ambition alone can bend the world to his will.
				</p>
				<p>
					Yet amid the chaos, a quiet truth persists: every heart, whether noble or common, beats with the same fragile hope that tomorrow’s tale might end in harmony
					rather than tragedy.
				</p>
				<p>If you want a version that leans more comedic, more tragic, more mystical, or more Macbeth‑y, I can conjure another.</p>
			</blockquote>

			<inline-share></inline-share>
		</rendered-content>
	</section>

	<section>
		<h3 id="iab-escape">In-App Browser Escape (<code>&lt;iab-escape&gt;</code>)</h3>
		<m-note data-type="info">
			<span>For various reasons, In-App Browsers are a <strong>curse</strong>. This JS component loads when you are in one of those.</span>
		</m-note>

		<p>To test the component click on the link below:</p>
		<p><a href="/styleguide/?iabEscape=true" rel="nofollow">Reload Page with IAB debugging enabled</a></p>
	</section>

	<section>
		<h3 id="logo">Logo (<code>&lt;m-logo&gt;</code>)</h3>

		<p><a href="/brand/">For logo information, see the brand page</a></p>
	</section>

	<section>
		<h3 id="note">Notes (<code>&lt;m-note&gt;</code>)</h3>

		<m-note data-type="success">
			<Icon name="mingcute:check-circle-line" aira-hidden="true" />
			<rendered-content>
				<p>You have been <strong>succeeded</strong>.</p>
			</rendered-content>
		</m-note>

		<m-note data-type="error">
			<Icon name="mingcute:alert-octagon-line" aira-hidden="true" />
			<rendered-content>
				<p>You have been <strong>errored</strong>.</p>
			</rendered-content>
		</m-note>

		<m-note data-type="warning">
			<Icon name="mingcute:alert-line" aira-hidden="true" />
			<rendered-content>
				<p>You have been <strong>warned</strong>.</p>
			</rendered-content>
		</m-note>

		<m-note data-type="alert">
			<Icon name="mingcute:alert-diamond-line" aira-hidden="true" />
			<rendered-content>
				<p>You have been <strong>alerted</strong>.</p>
			</rendered-content>
		</m-note>

		<m-note data-type="info">
			<Icon name="mingcute:information-line" aira-hidden="true" />
			<rendered-content>
				<p>You have been <strong>informed</strong>.</p>
			</rendered-content>
		</m-note>

		<m-note data-type="debug">
			<Icon name="mingcute:question-line" aira-hidden="true" />
			<rendered-content>
				<p>You have been <strong>debugged</strong>.</p>
			</rendered-content>
		</m-note>
	</section>

	<section>
		<h3 id="old-style-buttons">Old Style Buttons (<code>&lt;old-style-buttons&gt;</code> &amp; <code>&lt;old-style-button&gt;</code>)</h3>

		<OldStyleButtons />
	</section>

	<section>
		<h3 id="pagination">Pagination (<code>&lt;m-pagination&gt;</code>)</h3>

		<Pagination
			baseUrl="/err/"
			currentPage={2}
			lastPage={5}
			start={9}
			end={19}
			total={47}
			size={10}
			nofollow
		/>
	</section>

	<section>
		<h3 id="post-header">Post Header (<code>&lt;post-header&gt;</code>)</h3>

		<post-header>
			<header>
				{post.data.draft && <draft-tag>Draft</draft-tag>}
				<a class="u-uid u-url" href={Astro.url.pathname}>
					<h1 class="p-name" itemprop="headline" data-ignore-toc><Fragment set:html={markdown.inline(post.data.title)} /></h1>
				</a>

				{post.data.image && (
					<figure>
						<Image
							src={post.data.image}
							alt={post.data.imageAlt ?? ''}
							itemprop="image"
							loading="eager"
						/>
						{post.data.imageRights && <figcaption><Fragment set:html={markdown.inline(post.data.imageRights)} /></figcaption>}
					</figure>
				)}

				<blockquote class="p-summary" itemprop="description">
					<p><Fragment set:html={markdown.inline(post.data.summary)} /></p>
				</blockquote>

				<post-metadata>
					<span>
						Published on <time
							data-relative-time
							itemprop="datePublished"
							class="dt-published"
							datetime={post.data.createdAt.toISOString()}
						>{formatter.format(post.data.createdAt)}</time>.
					</span>

					{post.data.updatedAt && (
						<span>
							Updated on <time
								data-relative-time
								itemprop="dateModified"
								class="dt-updated"
								datetime={post.data.updatedAt.toISOString()}
							>{formatter.format(post.data.updatedAt)}</time>.
						</span>
					)}

					{post.readingTime && (
						<span>
							<time
								itemprop="timeRequired"
								class="dt-duration"
								datetime={`PT${post.readingTime}M`}
							>
								{post.readingTime} minute read
							</time>
							{post.wordCount && <span> &mdash; {post.wordCount} words</span>}
						</span>
					)}
				</post-metadata>

				<share-options></share-options>

				<read-article></read-article>
			</header>
		</post-header>
	</section>

	<section>
		<h3 id="prompt-injection">Prompt Injection (<code>&lt;pro-em-pt-br&gt;</code> &amp; <code>&lt;super-important&gt;</code>)</h3>

		<PromptInjection />
	</section>

	<section>
		<h3 id="radar-chart">Radar Chart (<code>&lt;radar-chart&gt;</code>)</h3>

		<radar-chart
			legend="Blog Tags"
			subtitle="Tags shown on the blog and their post count"
			hidden
			data-ignore-toc
		>
			{tags.map((tag) => <span data-name={tag.name} data-items={tag.items}>{tag.name} ({tag.items})</span>)}
		</radar-chart>
	</section>

	<section>
		<h3 id="read-article">Read Article (<code>&lt;read-article&gt;</code>)</h3>

		<read-article></read-article>
	</section>

	<section>
		<h3 id="related-posts">Related Posts (<code>&lt;related-posts&gt;</code>)</h3>

		<related-posts>
			<nav aria-labelledby="related-posts">
				<ul>
					{post.relatedPosts.map((relatedPost) => (
						<li>
							<Card
								url={`/blog/${relatedPost.url}`}
								itemtype="https://schema.org/BlogPosting"
								image={relatedPost.image}
								imageAlt={relatedPost.imageAlt ?? ''}
							>
								<Fragment slot="title" set:html={markdown.inline(relatedPost.title)} />
								<Fragment set:html={markdown.inline(relatedPost.summary)} />
							</Card>
						</li>
					))}
				</ul>
			</nav>
		</related-posts>
	</section>

	<section>
		<h3 id="scroll-to-top">Scroll to Top (<code>&lt;scroll-to-top&gt;</code>)</h3>

		<p>This will be visible overlaying the content as a link to the top of the page.</p>

		<m-note data-type="info">
			<span><strong>Note</strong>: this component will show on the bottom of the page and not in the middle of it.</span>
		</m-note>

		<scroll-to-top>
			<a href="#page-top">
				<Icon name="mingcute:arrow-to-up-line" aria-hidden="true" />
				<span>Scroll to top</span>
				<Icon name="mingcute:arrow-to-up-line" aria-hidden="true" />
			</a>
		</scroll-to-top>
	</section>

	<section>
		<h3 id="share-options">Share Options (<code>&lt;share-options&gt;</code>)</h3>

		<share-options></share-options>
	</section>

	<section>
		<h3 id="site-nav">Site Nav (<code>&lt;site-nav&gt;</code>)</h3>

		<SiteNav />
	</section>

	<section>
		<h3 id="skip-to-content">Skip to Main Content (<code>&lt;skip-to-content&gt;</code>)</h3>

		<p>This is the first element, and will be visible only when focused.</p>

		<button type="button" id="focus-skip-link">Focus skip link</button>
		<script type="module" is:inline>
			document.querySelector('#focus-skip-link')?.addEventListener('click', () => {
				(/** @type {HTMLAnchorElement} */ (document.querySelector('skip-to-content a')))?.focus({
					preventScroll: false,
					focusVisible: true
				});
			});
		</script>
	</section>

	<section>
		<h3 id="sr-only">Screen Reader Only (<code>&lt;sr-only&gt;</code>)</h3>

		<p>The text below will not be rendered visibly, but will still be available to screen readers.</p>
		<sr-only>This text will only be read by screen readers.</sr-only>
	</section>

	<section>
		<h3 id="tag-list">Tag List (<code>&lt;tag-list&gt;</code>)</h3>

		<tag-list>
			<ul>
				{post.data.tags?.map((tag) => (
					<li class="p-category">
						<tag-item>
							<a href={`/blog/tags/${tag}/`}>{tag}</a>
						</tag-item>
					</li>
				))}
			</ul>
		</tag-list>
	</section>

	<section>
		<h3 id="site-settings">Site Setting (<code>&lt;site-settings&gt;</code>)</h3>

		<site-settings></site-settings>
	</section>

	<section>
		<h3 id="toc">Table of contents (<code>&lt;table-of-contents&gt;</code>)</h3>

		<table-of-contents></table-of-contents>
	</section>

	<section>
		<h3 id="themed-image">Themed Image (<code>&lt;themed-image&gt;</code>)</h3>

		<div style="display: flex; flex-wrap: wrap; gap: var(--size-3)">
			<ThemedImage
				image={avatar}
				imageAlt="A picture of my face with a smile looking at the camera. I&apos;m wearing aviator glasses, a fake fur winter hat and an orange scarf."
				themeImages={{
					uwu: uwuAvatar,
					y2k: y2kAvatar,
					hacker: hackerAvatar,
					halloween: halloweenAvatar
				}}
			/>

			<ThemedImage
				theme="uwu"
				image={avatar}
				imageAlt="A picture of my face with a smile looking at the camera. I&apos;m wearing aviator glasses, a fake fur winter hat and an orange scarf."
				themeImages={{
					uwu: uwuAvatar,
					y2k: y2kAvatar,
					hacker: hackerAvatar,
					halloween: halloweenAvatar
				}}
			/>

			<ThemedImage
				theme="hacker"
				image={avatar}
				imageAlt="A picture of my face with a smile looking at the camera. I&apos;m wearing aviator glasses, a fake fur winter hat and an orange scarf."
				themeImages={{
					uwu: uwuAvatar,
					y2k: y2kAvatar,
					hacker: hackerAvatar,
					halloween: halloweenAvatar
				}}
			/>
		</div>
	</section>

	<section>
		<h3 id="m-webrings">Web Rings (<code>&lt;m-webrings&gt;</code>)</h3>

		<Webrings />
	</section>

	<section>
		<h3 id="wheel-of-fortune">Wheel of Fortune (<code>&lt;wheel-of-fortune&gt;</code>)</h3>

		<wheel-of-fortune items="Tim Hortons, Subway, A&W, Ice Cream, Pizza, Cinnamon Roll, Phở, Spring rolls, Nachos, Ramen, Hummus, Samosas"></wheel-of-fortune>
	</section>
</details>
