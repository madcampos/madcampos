---

---

<details open>
	<summary>
		<h2 id="block-elements">Block Level Text Elements</h2>
	</summary>

	<section>
		<h3 id="blockquote">Block Quote (<code>&lt;blockquote&gt;</code>)</h3>

		<figure>
			<blockquote>
				<p>
					Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
				</p>
				<p>
					Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate
					velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est
					laborum.
				</p>
			</blockquote>
			<figcaption><cite>Some Old Roman Dude, Probably</cite></figcaption>
		</figure>
	</section>

	<section>
		<h3 id="dl">Definition List (<code>&lt;dl&gt;</code>)</h3>

		<dl>
			<dt>definition (noun)</dt>
			<dd>A statement of meaning.</dd>

			<dt>list (noun)</dt>
			<dd>A series of things.</dd>
		</dl>
	</section>

	<section>
		<h3 id="figure">Figure (<code>&lt;figure&gt;</code>)</h3>

		<figure>
			<img
				src="/assets/test/good-parts.webp"
				alt="A photo of two books, side by side, with the first being much bigger than the second. The books are, respectively: Javascript the Definitive Guide; and Javascript the Good Parts"
				loading="lazy"
				width="512"
			/>
			<figcaption>The joys of web development</figcaption>
		</figure>
	</section>

	<section>
		<h3 id="hr">Horizontal Line (<code>&lt;hr&gt;</code>)</h3>

		<p>Regular line:</p>
		<hr />
	</section>

	<section>
		<h3 id="ol">Ordered List (<code>&lt;ol&gt;</code>)</h3>

		<ol>
			<li>
				<span>Cem</span>

				<ol>
					<li>
						<span>Cento e dez</span>
						<ol>
							<li>Cento e onze</li>
							<li>Cento e doze</li>
						</ol>
					</li>
					<li>
						<span>Cento e vinte</span>
						<ol>
							<li>Cento e vinte e um</li>
							<li>Cento e vinte e dois</li>
						</ol>
					</li>
				</ol>
			</li>
			<li>
				<span>Duzentos</span>

				<ol>
					<li>
						<span>Duzentos e dez</span>
						<ol>
							<li>Duzentos e onze</li>
							<li>Duzentos e doze</li>
						</ol>
					</li>
					<li>
						<span>Duzentos e vinte</span>
						<ol>
							<li>Duzentos e vinte e um</li>
							<li>Duzentos e vinte e dois</li>
						</ol>
					</li>
				</ol>
			</li>
		</ol>
	</section>

	<section>
		<h3 id="ul">Unordered List (<code>&lt;ul&gt;</code>)</h3>

		<ul>
			<li>
				<span>Things I like</span>

				<ul>
					<li>
						<span>Video Games</span>

						<ul>
							<li>Fallout 2</li>
							<li>Rollercoaster Tycoon 2</li>
						</ul>
					</li>
					<li>
						<span>Role-playing Games</span>

						<ul>
							<li>Shadowrun</li>
							<li>Paranoia</li>
						</ul>
					</li>
				</ul>
			</li>
			<li>
				<span>Things I dislike</span>

				<ul>
					<li>
						<span>Prejudice</span>

						<ul>
							<li>Homophobia</li>
							<li>Ableism</li>
							<li>Racism</li>
						</ul>
					</li>
				</ul>
			</li>
		</ul>
	</section>

	<section>
		<h3 id="p">Paragraph (<code>&lt;p&gt;</code>)</h3>

		<p>The quick brown fox jumped over the lazy dog.</p>
	</section>

	<section>
		<h3 id="pre">Preformatted Text (<code>&lt;pre&gt;</code>)</h3>

		<p>Simple text (ASCII art drawing of a whale):</p>
		<pre>
 __v_
(____\/&lcub;
</pre>
	</section>

	<section>
		<h3 id="menu">Menu (<code>&lt;menu&gt;</code>)</h3>

		<m-note data-type="info">
			<span><strong>Note:</strong> the <code>&lt;menu&gt;</code> element is no different semantically than the <code>&lt;ul&gt;</code> element.</span>
		</m-note>

		<menu>
			<li><button type="button" id="menu-button-1">Say "Hey"</button></li>
			<li><button type="button" id="menu-button-2">Say "Ho"</button></li>
			<li><button type="button" id="menu-button-3">Say "Hey Ho"</button></li>
		</menu>
		<script type="module" is:inline>
			// oxlint-disable-next-line no-alert
			document.querySelector('#menu-button-1')?.addEventListener('click', () => alert('Hey!'));
			// oxlint-disable-next-line no-alert
			document.querySelector('#menu-button-2')?.addEventListener('click', () => alert('Ho!'));
			// oxlint-disable-next-line no-alert
			document.querySelector('#menu-button-3')?.addEventListener('click', () => alert('Hey Ho!'));
		</script>
	</section>
</details>
