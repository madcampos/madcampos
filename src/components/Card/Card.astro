---
import './card.css';
import ThemedImage from '../ThemedImage/ThemedImage.astro';

interface Props {
	itemtype: string;
	url?: string;
	draft?: boolean;
	image?: ImageMetadata;
	imageAlt?: string;
	themeImages?: Record<string, ImageMetadata>;
	extraClass?: string;
}

const { itemtype, url, draft, image, imageAlt, themeImages, extraClass } = Astro.props;
---
<m-card class:list={[extraClass]}>
	<article itemscope {itemtype}>
		<template>
			<meta itemprop="url" content={url} />
			<slot name="metadata"></slot>
		</template>

		{image && (
			<ThemedImage
				{image}
				{imageAlt}
				{themeImages}
			/>
		)}

		<header>
			<card-title>
				{draft && <draft-tag>Draft</draft-tag>}
				<a href={url ?? null}>
					<slot name="title"></slot>
				</a>
			</card-title>

			<card-subtitle><slot name="subtitle"></slot></card-subtitle>
		</header>

		<rendered-content itemprop="description">
			<slot></slot>
		</rendered-content>

		<card-links>
			<slot name="links"></slot>
		</card-links>

		<footer>
			<slot name="footer"></slot>
		</footer>
	</article>
</m-card>
