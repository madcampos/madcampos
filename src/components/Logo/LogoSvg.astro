---
import type { AllLogoSizes, AllLogoThemes } from '../../pages/data/logo.zip';
import logoBaseCss from './logo-base.css?raw';

const MICRO_START_PADDING = 7;
const MICRO_END_PADDING = 2;
const MINI_START_PADDING = 8;
const MINI_END_PADDING = 4;
const FULL_START_PADDING = 17;
const FULL_END_PADDING = 4;

interface LogoItemStyle {
	fill?: string;
	stroke?: string;
	strokeWidth?: string;
	styles?: string;
}

interface LogoStyle {
	part?: LogoItemStyle;
	text?: LogoItemStyle & {
		font?: string,
		fontWeight?: string
	};
	extras?: LogoItemStyle;
}

interface Props {
	url?: URL | string;
	title?: string;
	subtitle: string;
	shortSubtitle: string;
	theme?: AllLogoThemes;
	size?: AllLogoSizes;
	styles?: LogoStyle;
}

function generateUniqueId() {
	return Math.trunc(Math.random() * 1000000).toString(16);
}

function generateSubtitle(paddingStart: number, paddingEnd: number, subtitleString: string) {
	// oxlint-disable-next-line unicorn/no-new-array
	const padStartSvg = /* svg */ `<tspan class="logo-text-padding-start">${new Array(paddingStart).fill('<tspan>-</tspan>').join('')}</tspan>`;
	// oxlint-disable-next-line unicorn/no-new-array
	const padEndSvg = /* svg */ `<tspan class="logo-text-padding-end">${new Array(paddingEnd).fill('<tspan>-</tspan>').join('')}</tspan>`;
	const subtitleSvg = [...subtitleString].map((char) => /* svg */ `<tspan>${char}</tspan>`).join('');

	return /* svg */ `${padStartSvg}<tspan class="logo-text-content">${subtitleSvg}</tspan>${padEndSvg}`;
}

const logoLabelId = generateUniqueId();
const { url, title, subtitle, shortSubtitle, theme = 'all', size = 'all', styles } = Astro.props;
let width = '';
let height = '';

switch (size) {
	case 'full':
		width = '3500';
		height = '900';
		break;
	case 'mini':
		width = '2000';
		height = '900';
		break;
	case 'micro':
		width = '1100';
		height = '900';
		break;
	case 'all':
	default:
		width = '100%';
		height = '100%';
}
---

<svg
	color-interpolation-filters="sRGB"
	preserveAspectRatio="xMidYMid meet"
	class="u-logo logo-svg"
	{width}
	{height}
	viewBox={size !== 'all' ? `0 0 ${width} ${height}` : null}
	role="img"
	aria-labelledby={`logo-label-${logoLabelId}`}
	shape-rendering="geometricPrecision"
>
	<title id={`logo-label-${logoLabelId}`}>Marco Campos' Logo{url ? `, to ${title ?? ''}` : ''}</title>
	{theme !== 'all' && <style is:inline set:html={logoBaseCss}></style>}

	<!-- Text -->
	<defs>
		{(['all', 'micro'].includes(size)) && (
			<text
				id={`logo-text-micro-${logoLabelId}`}
				x="95%"
				y="85%"
				alignment-baseline="middle"
				dominant-baseline="middle"
				text-anchor="end"
				fill-rule="nonzero"
				text-rendering="optimizeLegibility"
				data-size="micro"
			>
				<Fragment set:html={generateSubtitle(MICRO_START_PADDING, MICRO_END_PADDING, shortSubtitle)} />
			</text>
		)}
		{(['all', 'mini'].includes(size)) && (
			<text
				id={`logo-text-mini-${logoLabelId}`}
				x="95%"
				y="85%"
				alignment-baseline="middle"
				dominant-baseline="middle"
				text-anchor="end"
				fill-rule="nonzero"
				text-rendering="optimizeLegibility"
				data-size="mini"
			>
				<Fragment set:html={generateSubtitle(MINI_START_PADDING, MINI_END_PADDING, shortSubtitle)} />
			</text>
		)}
		{(['all', 'full'].includes(size)) && (
			<text
				id={`logo-text-full-${logoLabelId}`}
				x="95%"
				y="85%"
				alignment-baseline="middle"
				dominant-baseline="middle"
				text-anchor="end"
				fill-rule="nonzero"
				text-rendering="optimizeLegibility"
				data-size="full"
			>
				<Fragment set:html={generateSubtitle(FULL_START_PADDING, FULL_END_PADDING, subtitle)} />
			</text>
		)}
	</defs>

	<!-- Logo shapes -->

