---
import './themed-image.css';
import type { ImageOutputFormat } from 'astro';
import { Image } from 'astro:assets';
import type { ThemeSetting } from '../../assets/js/settings';
import { inlineMarkdownStrip } from '../../utils/markdown.ts';

interface Props {
	image: ImageMetadata;
	imageAlt?: string;
	themeImages?: Record<string, ImageMetadata>;
	extraClasses?: string[];
	isEager?: boolean;
	format?: ImageOutputFormat;
	theme?: ThemeSetting;
}

const { image, imageAlt, themeImages, extraClasses, isEager, format, theme } = Astro.props;
---
<themed-image data-theme={theme}>
	<picture itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
		<Image
			itemprop="contentUrl"
			class:list={extraClasses}
			src={image}
			alt={inlineMarkdownStrip(imageAlt ?? '')}
			loading={isEager ? 'eager' : 'lazy'}
			fetchpriority={isEager ? 'high' : 'auto'}
			widths={[64, 128, 256, 512]}
			width={256}
			sizes={`
				(max-width: 25rem) 128px,
				(max-width: 40rem) 256px,
				512px
			`}
			{format}
		/>
		{Object.entries(themeImages ?? {}).map(([theme, themeImage]) => (
			<Image
				itemprop="contentUrl"
				data-theme-image={theme}
				src={themeImage}
				alt={inlineMarkdownStrip(imageAlt ?? '')}
				loading="lazy"
				widths={[64, 128, 256, 512]}
				width={256}
				sizes={`
					(max-width: 25rem) 128px,
					(max-width: 40rem) 256px,
					512px
				`}
				hidden
				{format}
			/>
		))}
	</picture>
</themed-image>
